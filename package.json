{
  "name": "tonebridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tonebridge - an air-gapped acoustic data link: real-time MFSK modem, Reed-Solomon FEC and an authenticated secure channel, entirely in the browser.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "selftest": "node --experimental-strip-types --no-warnings tools/tonebridge.ts selftest",
    "cli": "node --experimental-strip-types --no-warnings tools/tonebridge.ts",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
